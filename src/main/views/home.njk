{% extends "template.njk" %}

{% block content %}
  <h1 class="govuk-heading-xl">Tasks</h1>

  {% if notice %}
    <div class="govuk-notification-banner" role="alert" aria-labelledby="success-banner-title">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="success-banner-title">Success</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-notification-banner__heading">{{ notice }}</p>
      </div>
    </div>
  {% endif %}
  {% if error %}
    <div class="govuk-error-summary" role="alert" tabindex="-1" aria-labelledby="error-summary-title">
      <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <p class="govuk-body">{{ error }}</p>
      </div>
    </div>
  {% endif %}

  <section aria-labelledby="tasks-heading">
    <h2 class="govuk-heading-l" id="tasks-heading">
      {% if statusFilter %}Tasks with status: {{ statusFilter }}{% else %}All tasks{% endif %}
    </h2>

    <form action="/" method="get">
      <div class="govuk-form-group">
        <label class="govuk-label" for="status">Filter by status</label>
        <select class="govuk-select" id="status" name="status">
          <option value="" {% if not statusFilter %}selected{% endif %}>All statuses</option>
          {% for status in statusOptions %}
            <option value="{{ status }}" {% if status == statusFilter %}selected{% endif %}>
              {{ status }}
            </option>
          {% endfor %}
        </select>
      </div>
      <button class="govuk-button" data-module="govuk-button" type="submit">Apply filter</button>
      {% if statusFilter %}
        <a class="govuk-link" href="/">Clear filter</a>
      {% endif %}
    </form>

    {% if tasks.length %}
      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m">
          {% if statusFilter %}Tasks with status: {{ statusFilter }}{% else %}All tasks{% endif %}
        </caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Case number</th>
            <th scope="col" class="govuk-table__header">Title</th>
            <th scope="col" class="govuk-table__header">Description</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header">Created date</th>
            <th scope="col" class="govuk-table__header">Due date</th>
            <th scope="col" class="govuk-table__header">Actions</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for task in tasks %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">{{ task.caseNumberDisplay }}</td>
              <td class="govuk-table__cell">{{ task.title }}</td>
              <td class="govuk-table__cell">{{ task.descriptionDisplay }}</td>
              <td class="govuk-table__cell">{{ task.status }}</td>
              <td class="govuk-table__cell">{{ task.createdDate }}</td>
              <td class="govuk-table__cell">{{ task.dueDateDisplay }}</td>
              <td class="govuk-table__cell">
                <a class="govuk-link" href="/tasks/{{ task.urlId }}">View task</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      {% if statusFilter %}
        <p class="govuk-body">There are no tasks with status "{{ statusFilter }}".</p>
      {% else %}
        <p class="govuk-body">There are no tasks to display.</p>
      {% endif %}
    {% endif %}
  </section>

  <section aria-labelledby="create-task-heading">
    <h2 class="govuk-heading-l" id="create-task-heading">Create a task</h2>
    <form action="/tasks" method="post">
      <div class="govuk-form-group">
        <label class="govuk-label" for="caseNumber">Case number</label>
        <input
          class="govuk-input"
          id="caseNumber"
          name="caseNumber"
          type="text"
          value="{{ form.caseNumber }}"
          required
        >
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="title">Task title</label>
        <input
          class="govuk-input"
          id="title"
          name="title"
          type="text"
          value="{{ form.title }}"
          required
        >
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="description">Description (optional)</label>
        <textarea
          class="govuk-textarea"
          id="description"
          name="description"
          rows="4"
        >{{ form.description }}</textarea>
      </div>
      <div class="govuk-form-group">
        <label class="govuk-label" for="dueDateTime">Due date and time</label>
        <input
          class="govuk-input"
          id="dueDateTime"
          name="dueDateTime"
          type="datetime-local"
          value="{{ form.dueDateTime }}"
          required
        >
      </div>
      <button class="govuk-button" data-module="govuk-button" type="submit">Create task</button>
    </form>
  </section>
{% endblock %}
