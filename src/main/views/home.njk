{% from "govuk/components/table/macro.njk" import govukTable %}

{% extends "template.njk" %}

{% block content %}
  <h1 class="govuk-heading-xl">Cases</h1>

  {% if error %}
    <p class="govuk-error-message" role="alert">{{ error }}</p>
  {% elif caseRows.length %}
    {{ govukTable({
      caption: "All cases",
      firstCellIsHeader: true,
      head: [
        { text: "Case number" },
        { text: "Title" },
        { text: "Description" },
        { text: "Status" },
        { text: "Created date" },
        { text: "Due date" }
      ],
      rows: caseRows
    }) }}
  {% else %}
    <p class="govuk-body">There are no cases to display.</p>
  {% endif %}
{% endblock %}
